	#include <vector>


class Solution {
private:
    void swap(std::vector<int> &v, int i, int j) {
        int aux = v[i];
        v[i] = v[j];
        v[j] = aux;
    }


    void selectionSort(std::vector<int> &v) {
        int n = v.size();
        for (int i = 0; i < n - 1; i++) {
            int posicion_menor = i;
           
            for (int j = i + 1; j < n; j++) {
                if (v[j] < v[posicion_menor]) {
                    posicion_menor = j;
                }
            }
           
            swap(v, i, posicion_menor);
           
        }
    }


public:
    double average(std::vector<int>& salary) {
        int n = salary.size();
   
        if (n <= 2) {
            return 0.0;
        }


        selectionSort(salary);
       
        int sum = 0;


        for (int i = 1; i < n - 1; ++i) {
            sum += salary[i];
        }


        int count = n - 2;
       
        return (double)sum / count;
    }
};

